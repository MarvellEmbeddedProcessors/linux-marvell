devlink dev eswitch set pci/0002:1c:00.0 mode switchdev

echo 1 > /proc/sys/net/ipv4/ip_forward
nft -f ./route.nft

++++++++ ./route.nft ++++
table inet x {

     flowtable f {
        hook ingress priority 0
        devices = { eth0, sdp1-0 }
        flags offload;
     }

    chain forward {
        type filter hook forward priority 0; policy accept;
        ct state { established, related } flow add @f
    }
}
+++++++++++++++++++++++++

5.c ROUTE + BRIDGE + SNAT

                         cn10k
 |-------|         |------------------------ |                |-------
 | x86   |---------|sdp1-0          br0 (eth0)|----------------| x86  |
 |       |         |192.168.11.1  192.168.9.1|                |      |
 ---------         |-------------------------                 --------
 192.168.11.200                                            192.168.9.100

insmod ./pcie-marvell-cnxk-ep.ko

./octep_cp_agent ./cn106xx.cfg 2>&1 > /tmp/octep-cp-log.txt &

ifconfig sdp1-0 192.168.11.1 up
ifconfig eth0 up
brctl addbr br0
brctl addif br0 eth0
insmod ./pan.ko
mount -t debugfs none /sys/kernel/debug/
echo 0 > /sys/kernel/debug/cn10k/pan/sw_mode

ifconfig pan up
ifconfig br0 192.168.9.1 up

devlink dev eswitch set pci/0002:1c:00.0 mode switchdev

echo 1 > /proc/sys/net/ipv4/ip_forward
nft -f ./route_nat.nft

+++++++ route_nat.nft +++++++++++++

table ip nat {
     flowtable f {
        hook ingress priority 0
        devices = { eth0, sdp1-0  }
        flags offload;
     }

     chain postrouting {
             type nat hook postrouting priority srcnat; policy accept;
             oifname "br0" snat to 192.168.9.1
     }

   chain forward {
        type filter hook forward priority 0; policy accept;
        ct state { established, related } flow add @f
    }

}

5. Debugfs
/sys/kernel/debug/cn10k/pan/

a) info : shows various netdevices that can participate PAN offload
b) route : Shows route table applicable for PAN.
c) stats : PAN statistics
d) sw_events : Shows 32 offload (L2, L3) events sent to switchdev
	       in sequence.
e)sw_mode : echo 0 to this file to switch from route table based L3 forwarding
	    to flow based L3 forwarding.
f)switch : Shows L2 offload MAC information.
g) test  : Unit test folder for some of the APIs
h) v4_fl_tbl : Shows L2 and L3 offloaded flow tuple and its hit count
